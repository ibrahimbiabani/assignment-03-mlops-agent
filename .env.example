# Copy to .env (git-ignored) and fill in. Never commit .env.

# --- docker compose ---
# Letters and digits only (it is written into a JSON file at container start).
AIRFLOW_ADMIN_PASSWORD=change-me

# --- agent (host side) ---
MLFLOW_TRACKING_URI=http://localhost:5000
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=change-me
AIRFLOW_ALLOWED_TRIGGER_DAGS=training_pipeline
