# Copy to .env (git-ignored) and fill in. Never commit .env.

# --- docker compose ---
# Letters and digits only (it is written into a JSON file at container start).
AIRFLOW_ADMIN_PASSWORD=change-me

# --- agent (host side) ---
MLFLOW_TRACKING_URI=http://localhost:5000
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=change-me
AIRFLOW_ALLOWED_TRIGGER_DAGS=training_pipeline

# Kubernetes: use the restricted context created from kubernetes/agent-rbac.yaml
K8S_CONTEXT=mlops-agent
K8S_ALLOWED_NAMESPACES=mlops-app

# LLM (Google Gemini, free tier) - key from https://aistudio.google.com
# Free-tier quotas are per model per day (e.g. gemini-3.5-flash: 20/day, reset at midnight
# Pacific); each agent question uses 2-5 requests. The agent walks this chain, best first,
# skipping models that are exhausted, rate limited, overloaded or not served.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=low
# Pacing: one request at a time, >= this many seconds apart, <= GEMINI_RPM per model per minute
GEMINI_MIN_INTERVAL_S=2
GEMINI_RPM=8
# Longest the agent waits for a model to become usable before giving up
GEMINI_MAX_WAIT_S=30

# Agent API: if set, every endpoint except /health requires "Authorization: Bearer <token>"
AGENT_API_TOKEN=
